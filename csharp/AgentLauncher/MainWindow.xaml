<Window x:Class="AgentLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Launcher"
        Width="400" Height="560"
        MinWidth="320" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BaseColor}"
        Foreground="{StaticResource TextColor}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="#2E1A47" Height="30" CornerRadius="0">
            <Grid>
                <Border Height="1" Background="{StaticResource MauveColor}" VerticalAlignment="Bottom"/>
                <TextBlock Text="Agent Launcher &amp; Terminal Themes"
                           Foreground="{StaticResource SubTextColor}"
                           FontFamily="Segoe UI" FontSize="10"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10,6,10,6">

                <!-- ── Directory Card ── -->
                <Border Background="{StaticResource CardColor}" CornerRadius="10"
                        Padding="0" Margin="0,0,0,6">
                    <StackPanel>
                        <Border Padding="10,8,10,4">
                            <TextBlock Text="Working Directory"
                                       Foreground="{StaticResource TextColor}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                        </Border>
                        <Border Background="{StaticResource ListBgColor}"
                                CornerRadius="0,0,10,10"
                                Margin="2,0,2,2">
                            <ListBox x:Name="DirListBox"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextColor}"
                                     BorderThickness="0"
                                     DisplayMemberPath="DisplayLabel"
                                     ItemContainerStyle="{StaticResource DirListBoxItem}"
                                     MinHeight="120"
                                     MaxHeight="220"
                                     SelectionMode="Single"
                                     MouseDoubleClick="DirListBox_MouseDoubleClick"
                                     PreviewMouseLeftButtonDown="DirListBox_PreviewMouseLeftButtonDown">
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Background Card ── -->
                <Border Background="{StaticResource CardColor}" CornerRadius="10"
                        Padding="0" Margin="0,0,0,6">
                    <StackPanel>
                        <Border Padding="10,8,10,4">
                            <TextBlock Text="Background Mode"
                                       Foreground="{StaticResource TextColor}"
                                       FontFamily="Segoe UI" FontSize="13" FontWeight="Bold"/>
                        </Border>

                        <Border Height="1" Background="{StaticResource BorderColor}"
                                Margin="10,0"/>

                        <!-- Radio Buttons (no emoji — use simple ASCII) -->
                        <RadioButton x:Name="RbAcrylic"
                                     GroupName="BgMode" Margin="10,6,10,0"
                                     Checked="OnModeChanged">
                            <TextBlock><Run Text="Acrylic" FontWeight="Bold"/> — frosted glass</TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="RbOpacity"
                                     GroupName="BgMode" Margin="10,2,10,0"
                                     Checked="OnModeChanged">
                            <TextBlock><Run Text="Opacity" FontWeight="Bold"/> — pure transparent</TextBlock>
                        </RadioButton>
                        <RadioButton x:Name="RbNone"
                                     GroupName="BgMode" Margin="10,2,10,4"
                                     Checked="OnModeChanged">
                            <TextBlock><Run Text="None" FontWeight="Bold"/> — solid color</TextBlock>
                        </RadioButton>

                        <!-- Slider (Grid layout for proper stretch) -->
                        <Grid Margin="10,4,10,8" Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Level:"
                                       Foreground="{StaticResource SubTextColor}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Slider x:Name="OpacitySlider" Grid.Column="1"
                                    Minimum="0" Maximum="100" Value="50"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnSliderChanged"/>
                            <TextBlock x:Name="OpacityLabel" Grid.Column="2"
                                       Text="50%"
                                       Foreground="{StaticResource TextColor}"
                                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                       Width="40" TextAlignment="Right"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Buttons ── -->
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnClaude"
                            Grid.Row="0" Grid.Column="0"
                            Content="Claude Code"
                            Style="{StaticResource GlowButton}"
                            Background="#35B368"
                            Height="36"
                            Margin="0,0,5,0"
                            Click="BtnClaude_Click"/>

                    <Button x:Name="BtnHermes"
                            Grid.Row="0" Grid.Column="1"
                            Content="Hermes"
                            Style="{StaticResource GlowButton}"
                            Background="#E89050"
                            Height="36"
                            Margin="5,0,0,0"
                            Click="BtnHermes_Click"/>

                    <Button x:Name="BtnSave"
                            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                            Content="Save Background"
                            Style="{StaticResource GlowButton}"
                            Background="#4A6DB8"
                            Height="36"
                            Margin="0,5,0,0"
                            Click="BtnSave_Click"/>
                </Grid>

                <!-- ── Status ── -->
                <TextBlock x:Name="StatusText"
                           Text="Lorien_Lab"
                           Foreground="{StaticResource SubtleColor}"
                           FontFamily="Segoe UI" FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,4"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
